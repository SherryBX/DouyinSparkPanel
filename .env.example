# 抖音续火任务配置示例 —— 复制为 .env 后填写
PROXY_ADDRESS=
MESSAGE_TEMPLATE=每日一言: [API]
HITOKOTO_TYPES=["文学","诗词","哲学"]
MATCH_MODE=short_id
BROWSER_TIMEOUT=120000
FRIEND_LIST_WAIT_TIME=2000
TASK_RETRY_TIMES=3
LOG_LEVEL=Debug
# 飞书自定义机器人 Webhook（可选）
FEISHU_WEBHOOK=
# 任务列表：username 仅标识；unique_id 决定 COOKIES_<UNIQUE_ID> 变量名
TASKS=[{"username":"Sherry","unique_id":"your_id","targets":["friend1","friend2"]}]
# Cookie-Editor 导出的 JSON 压成单行；ensure_ascii 转义亦可
COOKIES_YOUR_ID=
